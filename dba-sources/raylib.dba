rem ---------------------------------------------------------------------------
rem Define raylib commands, types and constants
rem ---------------------------------------------------------------------------

type Vector2
    x# as float
    y# as float
endtype

#load command "init window", "libraylib.so", "InitWindow", void, integer, integer, string
#load command "close window", "libraylib.so", "CloseWindow", void
#load command "sync rate", "libraylib.so", "SetTargetFPS", void, integer
#load command "window should close", "libraylib.so", "WindowShouldClose", integer
#load command "begin draw", "libraylib.so", "BeginDrawing", void
#load command "end draw", "libraylib.so", "EndDrawing", void
#load command "cls", "libraylib.so", "ClearBackground", void, dword
#load command "text", "libraylib.so", "DrawText", void, string, integer, integer, integer, dword
#load command "text width", "libraylib.so", "MeasureText", integer, string, integer
#load command "keystate", "libraylib.so", "IsKeyDown", boolean, integer
#load command "circle", "libraylib.so", "DrawCircleV", void, Vector2, float, dword

KEY_RIGHT = 262
KEY_LEFT = 263
KEY_DOWN = 264
KEY_UP = 265
KEY_W = 87
KEY_A = 65
KEY_S = 83
KEY_D = 68

rem ---------------------------------------------------------------------------
rem Beginning of DarkBASIC program
rem ---------------------------------------------------------------------------

type Screen
    width as integer
    height as integer
endtype

rem screen as Screen = Screen(1920, 1280)
screen as Screen = Screen(800, 600)
init window screen.width, screen.height, "raylib hello world"
sync rate 60

type Player
    id as integer
    pos as Vector2
    dims as Vector2
    health as integer
    speed# as float
endtype

player as Player = Player(1, Vector2(50, 50), Vector2(200, 80), 100, screen.width / 100)
player.pos = GetCenterPos(screen)

rem ---------------------------------------------------------------------------
rem Main loop
rem ---------------------------------------------------------------------------

while window should close() = 0

    rem move player with WASD or arrow keys
    right = keystate(KEY_D) or keystate(KEY_RIGHT)
    left = keystate(KEY_A) or keystate(KEY_LEFT)
    down = keystate(KEY_S) or keystate(KEY_DOWN)
    up = keystate(KEY_W) or keystate(KEY_UP)
    if right then player.pos.x# = incclamp(player.pos.x#, player.speed#, screen.width - player.dims.x#/2)
    if left then player.pos.x# = decclamp(player.pos.x#, player.speed#, player.dims.x#/2)
    if down then player.pos.y# = incclamp(player.pos.y#, player.speed#, screen.height - player.dims.y#/2)
    if up then player.pos.y# = decclamp(player.pos.y#, player.speed#, player.dims.y#/2)

    rem render
    begin draw
        cls 0xFF502020
        CenterText("Use WASD to move", Vector2(screen.width / 2, 50))
        DrawText(player.pos, player.dims)
        circle player.pos, 10, 0xFF00FF00
    end draw
endwhile

rem Clean up and exit program
close window
end

rem ---------------------------------------------------------------------------
rem Functions
rem ---------------------------------------------------------------------------

function GetCenterPos(screen)
endfunction Vector2(screen.width / 2, screen.height / 2)

function DrawText(pos, dims)
    x# = pos.x# - dims.x#/2
    y# = pos.y# - dims.y#/2
    text "yeaaaah boiii", x#, y#, 20, 0xFFFFFFFF
    text "oi ya cunt", x#, y# + 40, 40, 0xFFA0AA00
endfunction

function CenterText(str, pos)
    width = text width(str, 20)
    text str, pos.x# - width/2, pos.y# - 10, 20, 0xFFFFFFFF
endfunction

function incclamp(x, amount, max)
    x = x + amount
    if x > max then x = max
endfunction x

function decclamp(x, amount, min)
    x = x - amount
    if x < min then x = min
endfunction x

